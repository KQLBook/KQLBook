/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prod",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "prod"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kqlqueries-dev",
			"database_id": "88676c43-d091-4964-b9e1-33c1dbe7993e",
			"migrations_dir": "migrations"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "kqlqueries-search",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"ratelimits": [
		{
			"name": "AI_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "GITHUB_APP_ID",
			"store_id": "17a1510cff21480caeaa3e9ad8df980c",
			"secret_name": "github-app-id"
		},
		{
			"binding": "GITHUB_CLIENT_ID",
			"store_id": "17a1510cff21480caeaa3e9ad8df980c",
			"secret_name": "github-client-id"
		},
		{
			"binding": "GITHUB_CLIENT_SECRET",
			"store_id": "17a1510cff21480caeaa3e9ad8df980c",
			"secret_name": "github-client-secret"
		},
		{
			"binding": "DEEPSEEK_API_KEY",
			"store_id": "17a1510cff21480caeaa3e9ad8df980c",
			"secret_name": "deepseek-api"
		}
	],
	"vars": {
		"APP_URL": "https://kqlbook.com",
		"BETTER_AUTH_URL": "https://kqlbook.com",
		"DEEPSEEK_BASE_URL": "https://api.deepseek.com",
		"DEEPSEEK_MODEL": "deepseek-v4-flash",
		"NEXT_PRIVATE_MINIMAL_MODE": "true"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
}
